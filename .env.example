# Path to DuckDB directory (relative to repo root)
DATA_DIR=./data
DB_FILENAME=scanner.duckdb

# Publisher — where rare events get POSTed as JSON
PUBLISHER_URL=http://localhost:3000/api/rare-event
PUBLISHER_TOKEN=dev-token
PUBLISHER_ENABLED=true

# History to backfill on first run (days)
BACKFILL_DAYS=3650

# How often to re-scan (minutes)
SCAN_INTERVAL_MINUTES=60

# Rarity percentile threshold (0-100). Higher = fewer, rarer events.
# 99.0 = top 1%, 99.5 = top 0.5%, 100.0 = all-time records only
RARITY_THRESHOLD=99.0

# If true, events are logged but not POSTed.
DRY_RUN=false
